---
const afirmaciones = [
  'Tu negocio recibe preguntas por WhatsApp todos los días.',
  'Hay momentos en que nadie puede responder de inmediato.',
  'Quieres saber cómo está siendo atendido tu cliente, pero no puedes ver las conversaciones.',
];
---

<section id="para-quien-es" class="paraquien section">
  <div class="paraquien__inner">
    <div class="paraquien__col-izq">
      <div class="paraquien__eyebrow" aria-hidden="true"></div>
      <h2 class="paraquien__titulo reveal">
        Si recibes mensajes de clientes, Wapi es para ti.
      </h2>

      <p class="paraquien__remate reveal">
        Clínicas, restaurantes, despachos, salones, tiendas, talleres, notarías,
        gimnasios, inmobiliarias — si tus clientes te escriben, Wapi funciona para
        tu negocio.
      </p>
    </div>

    <ul class="paraquien__lista" data-reveal-group data-reveal-stagger="0.2">
      {afirmaciones.map((a) => <li class="paraquien__item reveal">{a}</li>)}
    </ul>
  </div>
</section>

<style>
  .paraquien {
    background: var(--color-surface);
  }
  .paraquien__inner {
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  /* Columna izquierda: título + industrias */
  .paraquien__col-izq {
    min-width: 0;
  }
  .paraquien__eyebrow {
    width: 40px;
    height: 2px;
    background: var(--color-primary);
    margin: 0 0 24px;
  }
  .paraquien__titulo {
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 40px);
    letter-spacing: -0.01em;
  }
  .paraquien__remate {
    margin-top: 32px;
    font-weight: 500;
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Columna derecha: lista editorial con separadores horizontales */
  .paraquien__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .paraquien__item {
    font-size: 19px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    padding-block: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .paraquien__item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .paraquien__item:last-child {
    padding-bottom: 0;
  }

  /* Desktop: 2 columnas, título fijo a la izquierda */
  @media (min-width: 768px) {
    .paraquien__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(48px, 8vw, 96px);
      align-items: start;
    }
    .paraquien__col-izq {
      position: sticky;
      top: 120px;
    }
    .paraquien__item {
      font-size: 21px;
      padding-block: 28px;
    }
  }
</style>
